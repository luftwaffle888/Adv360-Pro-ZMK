#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        space_tab: space_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "SPACE_TAB";
            bindings = <&kp SPACE>, <&kp TAB>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BSPC_DEL";
            bindings = <&kp BSPC>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        launcher: launcher {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "LAUNCHER";
        };

        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(LEFT_SHIFT)))>;
            label = "HYPER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        home_layer {
            bindings = <
&lt 3 BACKSPACE          &kp LEFT_GUI    &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE                &kp ENTER  &none                                       &none      &kp ENTER  &kp RIGHT_BRACE               &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_GUI    &lt 3 BACKSPACE
&kp TAB                  &kp Q           &kp W             &kp F                 &kp P                         &kp B      &none                                       &none      &kp J      &kp L                         &kp U                  &kp Y              &kp SQT          &kp EQUAL
&mt LEFT_CONTROL ESCAPE  &hm LEFT_GUI A  &hm LEFT_ALT R    &hm LEFT_SHIFT S      &hm LEFT_CONTROL T            &kp G      &none       &none  &none      &none  &none  &none      &kp M      &hm LEFT_CONTROL N            &hm RIGHT_SHIFT E      &hm RIGHT_ALT I    &hm RIGHT_GUI O  &kp SEMICOLON
&kp LEFT_SHIFT           &kp Z           &kp X             &kp C                 &hm LA(LC(LG(LEFT_SHIFT))) D  &kp V                         &none      &none                    &kp K      &hm LA(LG(LC(LEFT_SHIFT))) H  &kp COMMA              &kp DOT            &kp FSLH         &caps_word
&none                    &none           &none             &none                 &none                                    &space_tab  &mo 2  &none      &none  &mo 1  &bspc_del             &none                         &none                  &none              &none            &none
            >;
        };

        sym_num_layer {
            bindings = <
&none  &none           &none     &none      &none      &none          &tog 0                                    &none   &none      &none         &none   &none   &none      &none
&none  &kp TILDE       &kp AMPS  &kp STAR   &kp GRAVE  &kp SLASH      &none                                     &none   &kp EQUAL  &kp N7        &kp N8  &kp N9  &none      &none
&none  &kp MINUS       &kp DLLR  &kp PRCNT  &kp CARET  &kp PIPE       &none   &none   &none      &none  &none   &none   &kp DOT    &kp NUMBER_4  &kp N5  &kp N6  &kp PLUS   &kp ASTERISK
&none  &kp UNDERSCORE  &kp EXCL  &kp AT     &kp HASH   &kp BACKSLASH                  &none      &none                  &kp N0     &kp N1        &kp N2  &kp N3  &kp MINUS  &kp SLASH
&none  &none           &none     &none      &none                     &trans  &trans  &none      &none  &trans  &trans             &none         &none   &none   &none      &none
            >;
        };

        nav_layer {
            bindings = <
&kp LC(LG(Q))  &none                      &none                      &none                        &none                   &none           &tog 0                                     &none  &none           &none           &none         &none            &none  &none
&none          &kp LS(LG(N1))             &kp LS(LG(N2))             &kp LS(LG(N3))               &kp LS(LG(N4))          &kp LS(LG(N5))  &none                                      &none  &none           &none           &none         &none            &none  &none
&launcher      &hm LEFT_GUI LG(NUMBER_1)  &hm LEFT_ALT LG(NUMBER_2)  &hm LEFT_SHIFT LG(NUMBER_3)  &hm LCTRL LG(NUMBER_4)  &kp LG(N5)      &none      &none  &none      &none  &none  &none  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none  &none
&none          &none                      &none                      &none                        &none                   &none                             &none      &none                &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &none  &none
&none          &none                      &none                      &none                        &none                                   &launcher  &none  &none      &none  &none  &none                  &none           &none         &none            &none  &none
            >;
        };

        config_layer {
            bindings = <
&none  &tog 1        &tog 2        &tog 3        &tog 4        &none         &bootloader                                       &bootloader             &none  &kp F10     &kp F11     &kp F12  &rgb_ug RGB_TOG  &none
&none  &none         &none         &none         &none         &none         &none                                             &none                   &none  &kp F7      &kp F8      &kp F9   &bl BL_TOG       &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR   &none  &none      &none  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &kp F4      &kp F5      &kp F6   &bl BL_INC       &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                      &none  &kp F1      &kp F2      &kp F3   &bl BL_DEC       &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none  &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none    &none            &none
            >;
        };

        qwerty_layer {
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 0                                                   &none      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&none      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &none
            >;
        };
    };
};
